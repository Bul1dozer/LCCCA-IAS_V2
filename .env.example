# LCCCA-IAS environment template
#
# Copy to .env and replace every CHANGE_ME value before real use.

# Environment
LCCA_ENV=development
LCCA_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Database
# Local pilot only:
DATABASE_URL=sqlite:///./lcca.db
# Recommended production example:
# DATABASE_URL=postgresql://lcca:CHANGE_ME@localhost:5432/lcca_ias

# Session security
LCCA_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
LCCA_SESSION_COOKIE_SECURE=false
LCCA_SESSION_MAX_AGE=28800
LCCA_SESSION_SAMESITE=lax
LCCA_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# TOTP encryption
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LCCA_TOTP_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# Rate limiting
# Development:
LCCA_RATE_LIMIT_BACKEND=memory
# Production:
# LCCA_RATE_LIMIT_BACKEND=redis
# LCCA_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
LCCA_LOGIN_WINDOW_SECONDS=300
LCCA_LOGIN_MAX_ATTEMPTS=5
LCCA_RESET_WINDOW_SECONDS=900
LCCA_RESET_MAX_ATTEMPTS=5

# Password reset email
# Development/test sink:
LCCA_MAIL_PROVIDER=sink
LCCA_MAIL_SINK_PATH=.pytest_tmp/mail_sink.jsonl
# Production uses SMTP configuration saved in Settings, or a future approved provider.

# Development-only fallback. Keep off in production.
LCCA_ALLOW_DEV_RESET_TOKEN=0

# Docker/PostgreSQL helpers
POSTGRES_USER=lcca
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=lcca_ias
